 "01-28": {
  "nom": "Saint Thomas d’Aquin, docteur",
  "carnet": "Sanctoral (septembre-janvier)",
  "offices": {
   "laudes": {
    "hymnes": [
     {
      "titre": "Au sein de son Église",
      "f": [
       "op/01-28-02.jpg"
      ]
     },
     {
      "titre": "Loué sois-tu, Jésus, toi le témoin fidèle",
      "f": [
       "op/01-28-03.jpg"
      ],
      "texte": [
       [
        "Loué sois-tu Jésus, toi le témoin fidèle",
        "Pour saint Thomas que tu as revêtu de ton Esprit",
        "Tu l’as mené sur le chemin de ton Royaume",
        "Et dans ton amour des hommes / tu as fait route avec lui."
       ],
       [
        "Loué sois-tu ô Christ pour saint Thomas notre frère",
        "Tu as rendu son cœur ardent pour les Écritures",
        "Il contemplait ta beauté, toi qui t’es révélé",
        "Lui qui t’a désiré pour unique récompense."
       ],
       [
        "Loué sois-tu ô Christ pour saint Thomas notre frère",
        "Lui qui fut pour ton Église miroir de lumière et d’intelligence",
        "Il nous enseigne les splendeurs du Verbe",
        "La profondeur des Écritures / et la voie très pure de ta vérité."
       ],
       [
        "Gloire au Père qui nous appelle à son Royaume",
        "Gloire au Christ Verbe de Dieu",
        "Gloire à l’Esprit qui nous donne la vie",
        "Trinité bienheureuse / gloire à toi."
       ]
      ]
     },
     {
      "titre": "Thomas, toujours tourné vers Dieu",
      "f": [
       "op/01-28-04.jpg",
       "op/01-28-05.jpg",
       "op/01-28-06.jpg"
      ]
     },
     {
      "titre": "Thomas, chercheur du Dieu vivant (choral)",
      "f": [
       "op/01-28-07.jpg",
       "op/01-28-08.jpg"
      ]
     }
    ],
    "psalmodie": [
     {
      "ant": "Brûlante est ta parole, Seigneur mon Dieu : c’est pourquoi ton serviteur l’a aimée.",
