\setlength{\textheight}{5cm}

\begin{lilypond}
	\layout {
		\context {
			\Lyrics
			\consists "Bar_engraver"
			\consists "Separating_line_group_engraver"
			\hide BarLine
		}
	}
	\include "Ft_Gar_12pt_.ly" 
	\include "Exsultet/Exsultet 2021 Commandes.ly"	
	\new Staff \with {\remove Time_signature_engraver }
	<< 
	\cadenzaOn \key f \major
	\new Voice = "melodie" \relative c'' { 
		\musA
	}	
	\new Lyrics \with {\override VerticalAxisGroup.staff-affinity = #CENTER }
	\lyricsto "melodie" {
		\textA
	}
	>>
\end{lilypond}



\makeatletter
\patchcmd\@outputpage{\textheight}{\ifodd\count\z@ 14.5cm\else \hauteur\fi}{}{}
\makeatother	

\begin{lilypond}
	\layout {
		\context {
			\Lyrics
			\consists "Bar_engraver"
			\consists "Separating_line_group_engraver"
			\hide BarLine
		}
	}
	\include "Ft_Gar_12pt_.ly" 
	\include "Exsultet/Exsultet 2021 Commandes.ly"	
	\score {
		\new Staff \with {\remove Time_signature_engraver }
		<< 
		\cadenzaOn \key f \major
		\new Voice = "melodie" \relative c' { 
			\musDial
		}
		
		\new Lyrics \with {\override VerticalAxisGroup.staff-affinity = #CENTER }
		\lyricsto "melodie" {
			\textDial
		}
		>>
		\layout { indent = #10 }
	}
\end{lilypond}

