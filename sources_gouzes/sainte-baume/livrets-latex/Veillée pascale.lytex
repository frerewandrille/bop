\section{Exsultet}
\renewcommand{\thefootnote}{}
\footnote{\includegraphics[width=0.85\linewidth]{0Le_Christ.pdf}}
\begin{lilypond}
	\include "Ft-gal.ly"\include "Ft-11pt.ly"\include "Ft-Gar.ly" 
	\include "Veillée pascale/Exsultet 2021 Commandes.ly"
	\new Staff \with {\remove Time_signature_engraver }
	<< 
	\cadenzaOn \key f \major \new Voice = "melodie" { \Mus-Intro }
	\new Lyrics \lyricsto "melodie" { \Texte-Intro }
	>>
\end{lilypond}


\begin{lilypond}
	\include "Ft-gal.ly"\include "Ft-11pt.ly"\include "Ft-Gar.ly" 
	\include "Veillée pascale/Exsultet 2021 Commandes.ly"
	\new Staff \with {\remove Time_signature_engraver }
	<< 
	\cadenzaOn \key f \major \new Voice = "melodie" { \Mus-dial }
	\new Lyrics \with {\override VerticalAxisGroup.staff-affinity = #CENTER } 
	\lyricsto "melodie" { \Texte-dial }
	>>
\end{lilypond}
\footnote{\includegraphics[width=0.65\linewidth]{0Gloire.pdf}}

\begin{lilypond}
	\include "Ft-gal.ly"\include "Ft-11pt.ly"\include "Ft-Gar.ly" 
	\include "Veillée pascale/Exsultet 2021 Commandes.ly"
	\new Staff \with {\remove Time_signature_engraver }
	<< 
	\cadenzaOn \key f \major \new Voice = "melodie" { \musBI\break\musBII\break\musBIII }
	\new Lyrics \with {\override VerticalAxisGroup.staff-affinity = #CENTER } 
	\lyricsto "melodie" { \textBI\textBII\textBIII }
	>>
\end{lilypond}
\footnote{\includegraphics[width=0.65\linewidth]{0Gloire.pdf}}

