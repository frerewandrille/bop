\end{lilypond}

\chapter{Cantique de la lettre \mbox{aux Romains}}
\par\label{NTIV}\begin{lilypond}
	\include "FtHy.ly" \include "Cantiques NT/Rm 6 K022.ly" 
\end{lilypond}
\dstr
 \vers{6,\,4}Par le baptême, ' nous avons été ensevelis avec lu\gras{i} dans la Mort,\par
comme le Christ est ressuscité des morts ' pour la glo\gras{i}re du Père,\par
nous vivrons, nous auss\gras{i}, dans une Vie nouvelle.
\fstr
\dstr
 \vers{5}C'est un même être que nous sommes deven\gras{u}s avec le Christ,\par
par une mort sembl\gras{a}ble à la sienne.\par
Et nous le serons auss\gras{i} par une résurrection semblable à la sienne.
\fstr
\dstr
 \vers{6}Notre vieil homme a été crucifi\gras{é} avec lui,\par
pour que fut détruit ce c\gras{o}rps de péché,\par
afin que nous ne soyions plus asserv\gras{i}s au péché.
\fstr
\dstr
 \vers{8}Mais, si nous sommes m\gras{o}rts avec le Christ,\par
nous croyons que nous vivrons auss\gras{i} avec lui,\par
car le Christ, ressuscité des m\gras{o}rts, ne meurt plus.
\fstr
\dstr
 \vers{9}La Mort n'a plus d'emp\gras{i}re sur lui:\par
sa Mort fut une mort au péch\gras{é}, ' une fois pour toutes.\par
Mais sa Vie est une v\gras{i}e pour Dieu.
\fstr
\dstr
Gloire au Père, et au F\gras{i}ls, et au Saint Esprit,\par
au Dieu qui est, ' qui éta\gras{i}t, et qui vient,\par
pour les si\gras{è}cles des siècles. Amen.
\fstr

\vfill\vfill
\rubrique{Ad libitum, les cantiques de l'office romain:}\vfill\null

