\fancyhead[OR]{\color{gray}\large\uppercase{\scshape\leftmark}}

\chapter{Cantique de la 2\up{e} lettre \mbox{aux Corinthiens}}
\par\label{NTV}\begin{lilypond}
	\include "FtAnt.ly" \include "Cantiques NT/2Co 5 K023.ly" 
\end{lilypond}
\dstr
 \vers{5,\,17}Si quelqu'un est dans le Christ,\par
il est une création nouvelle:\par
 ce qui est ancien a disparu,\par
un être nouveau est apparu!
\fstr
\dstr
 \vers{18}Et toute chose vient de Dieu,\par
qui nous a réconciliés avec lui par le Christ;\par
 et c'est à nous qu'il a confié\par
le ministère de la réconciliation.
\fstr
\dstr
 \vers{19}C'était Dieu qui, dans le Christ,\par
se réconciliait l'Univers,\par
 ne tenant plus compte\par
des fautes des hommes.
\fstr
\dstr
 Il a mis sur nos lèvres\par
la Parole de réconciliation:\par
 \vers{20a}nous sommes en ambassade pour le Christ,\par
c'est Dieu qui exhorte en nous!
\fstr
\dstr
 \vers{21}Celui qui n'avait pas connu le péché,\par
Dieu L'a fait péché pour nous\par
 afin qu'en lui nous devenions\par
justice de Dieu.
\fstr
\newpage
