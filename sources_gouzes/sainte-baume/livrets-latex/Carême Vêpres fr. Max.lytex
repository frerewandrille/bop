\end{lilypond}
\rubrique{Cantique p. \pageref{NTI}.}%{2ex}{0pt}
\newpage\null\thispagestyle{empty}
\chapter{Dimanche II}
\label{ReponsDiII}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/Louange à toi, Jésus K220.ly" 
\end{lilypond}
\pagebreak
\paragraph{1.}Jésus prit avec lu\gras{i} ' Pierre, Jacques, et Jean son frère,\\
Il les emmen\gras{a} ' sur une haute montagne,\\
Et, tandis qu'il priait, ' il fut transfiguré devant eux,\\
Et ses vêtements devinrent blancs ' comme la neige.
\paragraph{2.}Dieu, pers\gras{o}nne ne l'a jamais vu,\\
Mais le Fils qui est dans le sein du P\gras{è}re, ' lui, nous l'a révélé.\\
Et nous avons vu la gloire qu'il tient de son Père\\
Comme Fils unique ' plein de grâce et de vérité.
\paragraph{Doxologie}Gloire à Dieu ' dont la vo\gras{i}x a retenti du haut des cieux.\\
Gloire au Fils bien-aim\gras{é} ' en qui le Père a mis tout son amour.\\
Gloire à l'Esprit ' qui prend les apôtres dans une nuée de lumière.\\
Aux trois, louange et gloire ' pour les siècles sans fin.


\bigskip\rubrique{Antienne du cantique évangélique}%{2ex}{0pt}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Antiennes/Seigneur, tu es ma lumière K211.ly" 
\end{lilypond}
%\rubrique{Cantique p. \pageref{NTI}.}%{2ex}{0pt}

\chapter{Dimanche III}
\label{ReponsDiIII}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/Vous tous qui avez soif K320.ly" 
\end{lilypond}
\pagebreak
\paragraph{1.}Si tu savais le don de Dieu\\
Et quel est celu\gras{i} qui te demande à boire,\\
C'est toi qui lui aura\gras{i}s demandé,\\
Et il t'aurait donné de l'eau vive.
\paragraph{2.}Vous tous qui avez soif, ' venez vers l'eau.\\
Voici. ' Je répands des fl\gras{o}ts sur le sol assoiffé.\\
Sur tes enf\gras{a}nts, ' je répands mon Esprit.\\
Que l'homme de désir boive l'eau de la vie!
\paragraph{Doxologie}Louange au Dieu unique et trois fois saint!\\
En vérité, je vous le d\gras{i}s: ' L'heure vient, et nous y sommes,\\
Où les vrais adorate\gras{u}rs ' adoreront le Père\\
Dans l'Esprit et la Vérité.


\bigskip\rubrique{Antienne du cantique évangélique}%{2ex}{0pt}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Antiennes/Viens à mon aide B233.ly" 
\end{lilypond}
\rubrique{Cantique p. \pageref{NTI}.}%{2ex}{0pt}

\chapter{Dimanche IV}
\label{ReponsDiIV}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/Comme l'aveugle K420.ly" 
\end{lilypond}
\pagebreak
\paragraph{1.}Celui qu'on appelle Jésus a fait de la boue,\\
Il m'a enduit les yeux et m'a dit:\\
\og{}Va te laver à Siloë, ' à la piscine de l'Envoyé!\fg{}\\
Alors j'y suis allé, ' je m'y suis lavé, ' et je vois!
\paragraph{2.}Dieu est lumière. ' En lui, point de ténèbres.\\
Éveille-toi, ô toi qui dors, ' et le Christ t'illuminera!\\
Car c'est toi, Seigneur, mon flambeau:\\
Ô mon Dieu, ' illumine mes ténèbres.
\paragraph{Doxologie}Gloire au Père des lumières ' de qui vient tout don parfait.\\
Gloire au Fils de l'homme, ' lumière né de la lumière.\\
Gloire à l'Esprit ' qui ouvre les yeux de notre cœur\\
À l'œuvre de salut, ' quand Jésus nous est envoyé.


\bigskip\rubrique{Antienne du cantique évangélique}%{2ex}{0pt}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Antiennes/Qui me suit K413.ly" 
\end{lilypond}
\rubrique{Cantique p. \pageref{NTI}.}%{2ex}{0pt}

\chapter{Dimanche V}
\label{ReponsDiV}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/Gloire à toi, Christ K520.ly" 
\end{lilypond}
\paragraph{1.}Laz\gras{a}re! ' Viens dehors!\\
Je t'appelle, et to\gras{i}, tu me réponds.\\
Éveille-toi, ô toi qui dors! ' Relève-to\gras{i} d'entre les morts!\\
Je suis la résurrecti\gras{o}n et la vie éternelle!
\pagebreak\paragraph{2.}Toi qui as fait surg\gras{i}r du tombeau\\
Lazare ensevel\gras{i} depuis quatre jours,\\
\begin{minipage}{\linewidth}
	Tu as visit\gras{é} le domaine des morts\\
	Pour qu'ils voient la lumi\gras{è}re et contemplent ton visage.
\end{minipage}
\paragraph{Doxologie}Gloire au Père qui a ressuscité Jés\gras{u}s d'entre les morts\\
Et qui lui a donn\gras{é} de disposer de la vie.\\
Gloire au Fils qui ouvre nos tombea\gras{u}x et met en nous son Esprit.\\
Gloire à l'Esprit qui habite en nos c\gras{o}rps et leur donne la vie.

\bigskip\rubrique{Antienne du cantique évangélique}%{2ex}{0pt}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Antiennes/Tu as tiré K513.ly" 
\end{lilypond}
\rubrique{Cantique p. \pageref{NTI}.}%{2ex}{0pt}

\chapter{Dimanche des Rameaux \mbox{et de la Passion}}
\label{ReponsR}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/O Christ tu t'avances L050.ly" 
\end{lilypond}
\paragraph{1.}Réjouis-toi, fille de Sion! ' Exulte de to\gras{u}tes tes forces!\\
Voici que ton ro\gras{i} s'avance vers toi:\\
Hosanna au plus haut des cieux!\\
Béni soit celui qui vi\gras{e}nt, le Seigneur Di\gras{e}u qui nous illumine!
\paragraph{2.}Formez un cort\gras{è}ge, rameaux en main!\\
Rendez grâce au Seigne\gras{u}r, car éternel est son amour!\\
Voici l'Époux qui vient! ' Allons à sa rencontre!\\
L'Esprit et l'Épouse disent: Vi\gras{e}ns! ' Hosann\gras{a} au fils de David!
\paragraph{Doxologie}Rendez gloire au Seigneur, car étern\gras{e}l est son amour!\\
Gloire à Dieu notre P\gras{è}re, qui nous a donné son Fils unique.\\
Gloire au Fils, qui vient visiter le peuple de l'Alliance.\\
Gloire à l'Esprit ' qui hab\gras{i}te les lou\gras{a}nges d'Israël.
\newpage

\bigskip\rubrique{Antienne du cantique évangélique}%{2ex}{0pt}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Antiennes/Avec les enfants L063.ly" 
\end{lilypond}
\rubrique{Cantique p. \pageref{NTI}.}%{2ex}{0pt}

\newpage\null\thispagestyle{empty}
\chapter{Lundi Saint}
\label{ReponsLS}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/Pitié pour nous L220.ly" 
\end{lilypond}
\paragraph{1.}Ô croix, arbre nouveau du Roya\gras{u}me qui vient\\
Où viennent s'abrit\gras{e}r les nations dispersées,\\
En toi, tous sont sauvés\\
Et tressa\gras{i}llent de joie.
\pagebreak\paragraph{Doxologie}Gloire au Père, ' au F\gras{i}ls, ' au Saint Esprit,\\
Comme il éta\gras{i}t au commencement,\\
Maintenant et toujours,\\
Dans les si\gras{è}cles des siècles.

\bigskip\rubrique{Antienne du cantique évangélique}%{2ex}{0pt}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Antiennes/Comme le Père K636.ly" 
\end{lilypond}
\rubrique{Cantique p. \pageref{NTI}.}%{2ex}{0pt}

\chapter{Mardi Saint}
\label{ReponsMaS}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/Je donne ma vie L320.ly" 
\end{lilypond}
\paragraph{1.}Maintenant, le Fils de l'homme ' va entr\gras{e}r dans le royaume de la mort.\\
La nuit est avancée ' et déj\gras{à} le jour est proche\\
Où le Seigneur crucifi\gras{é} ' brisera les puissances de l'Enfer.
\pagebreak
\paragraph{Doxologie}Maintenant, ô maîtres souverain, ' P\gras{è}re des miséricordes,\\
Nos yeux ont vu ton salut, ' Jésus ton F\gras{i}ls, mort sur la croix,\\
Et dans l'Esprit de vie, ' nous célébrons l'amo\gras{u}r du cœur de notre Dieu.

\bigskip\rubrique{Antienne du cantique évangélique}%{2ex}{0pt}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Antiennes/Père, glorifie C108.ly" 
\end{lilypond}
\rubrique{Cantique p. \pageref{NTI}.}%{2ex}{0pt}

\chapter{Mercredi Saint}
\label{ReponsMeS}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/Nous annonçons L420.ly" 
\end{lilypond}
\paragraph{1.}Je suis crucifi\gras{é} avec le Christ,\\
Et si je vis, ' ce n'est plus moi qui vis,\\
Mais c'est le Christ mort et ressuscité\\
qui v\gras{i}t en moi.
\pagebreak
\paragraph{Doxologie}Gloire au Père, ' qui n'a pas abandonné l'h\gras{o}mme à la mort.\\
Gloire au Fils, sagesse éternelle, ' et source du salut.\\
Gloire à l'Esprit d'amour\\
Qui fait de no\gras{u}s des vivants.

