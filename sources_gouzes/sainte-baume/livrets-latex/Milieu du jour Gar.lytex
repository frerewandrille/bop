		\include "Ft_Gar_10pt_t.ly" \include "Antiennes/En ces jours-là H037.ly"
\end{lilypond}

	\versLect{Les nations verront ta justice,}{ tous les rois verront ta gloire.}

	
	
	\begin{multicols}{2}[\section{Carême}]
		\dstr
		Voici l’heure où le Christ eut soif,\\
		L'heure où il monta sur la croix;\\
		Qu'il donne soif de la justice\\
		À ceux qui le chantent à cette heure.
		\fstr\dstr
		Qu'ils ressentent aussi cette faim\\
		Que lui seul peut rassasier;\\
		Que le péché leur soit dégoût\\
		Et la vertu, tout leur désir.
		\fstr
		\dstr
		Qu’il répande sur ceux qui chantent\\
		Le don du Saint Esprit de Dieu,\\
		Tempérant l’ardeur de la chair,\\
		Réchauffant la froideur de l’âme.
		\fstr\dstr
		Implorons le Christ et le Père\\
		Et l’Esprit du Père et du Christ:\\
		Ô Trinité, une et puissante,\\
		Daigne écouter ceux qui te prient.
		\fstr
	\end{multicols}\null\smallskip
	
	\begin{lilypond}
		\include "Ft_Gar_10pt_t.ly" \include "Antiennes/Je suis le Dieu vivant K653.ly" 
	\end{lilypond}
	
	\begin{multicols}{2}
		\rubrique{Avant les Rameaux}
		
		\versLect{Détourne ta face de mes fautes}{ enlève tous mes péchés.}
		
		\rubrique{Le 5\up{e} dimanche \mbox{et pendant la Semaine Sainte}}
		
		\versLect{Ce sont nos souffrances qu'il a portées, }{ nos douleurs qu'il a supportées.}
	\end{multicols}\null
	
	
	\begin{multicols}{2}[\section{Temps pascal}]
		\dstr
		Venez, serviteurs, suppliez,\\
		Célébrez du cœur et des lèvres\\
		Par vos louanges, vos cantiques,\\
		Le nom béni de notre Dieu.
		\fstr\dstr
		Car voici revenu le temps\\
		Où, par une injuste sentence,\\
		Les mortels livrent à la mort\\
		Celui qui doit juger les siècles.
		\fstr\dstr
		Nous, qui lui devons notre amour,\\
		L'hommage d'une juste crainte,\\
		Pour tenir contre les assauts\\
		De notre cruel ennemi,
		\fstr\dstr
		Supplions l'Unique: le Père,\\
		Le Fils, qui est Dieu et qui règne,\\
		Avec eux aussi, l'Esprit Saint;\\
		En sa Trinité, le Seigneur.
		\fstr
	\end{multicols}\null\bigskip
	
	\begin{lilypond}
		\include "Ft_Gar_10pt_t.ly" \include "Antiennes/Alléluia N070.ly" 
	\end{lilypond}
	
	\begin{multicols}{2}
		\rubrique{Pendant l'Octave}
		
		\versLect{Voici le jour que fit le Seigneur, }{ jour de fête et de joie, alléluia!}
		
		\rubrique{Après l'Octave}
		
		\versLect{Les disciples furent remplis de joie, alléluia, }{ à la vue du Seigneur, alléluia.}
	\end{multicols}\null
	
	
