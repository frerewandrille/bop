\deb \og{}J'ai impos\gras{é} le diad\gras{è}me à un pre\gras{u}x,\mediante
j'ai exalt\gras{é} un cad\gras{e}t de mon pe\gras{u}ple.
\fstrophe
\dstrophe
\deb \vers{21}\ogSuppr{}J'ai trouv\gras{é} Dav\gras{i}d mon servite\gras{u}r,\mediante
je l'ai o\gras{i}nt de mon hu\gras{i}le sa\gras{i}nte;\finale
\deb \vers{22}pour lu\gras{i} ma ma\gras{i}n sera f\gras{e}rme,\mediante
mon br\gras{a}s auss\gras{i} le rendra f\gras{o}rt.\fg{}
\fstrophe
