\chapter{Jeudi Saint}
\label{ReponsJS}
\par\begin{lilypond}
	\include "FtAnt.ly" \include "Répons/Je vous donne L545.ly" 
\end{lilypond}
\paragraph{1.}Cloué de chair et d'esprit\\
À la croix du Seigne\gras{u}r Jésus-Christ,\\
Affermis dans son amo\gras{u}r ' par le sang du Christ,\\
Aimons-nous les uns les autres, ' comme il nous a aimés.
\pagebreak\paragraph{2.}Le Seigneur Jésus,\\
La nuit qu'il f\gras{u}t livré,\\
Ayant aimé les siens ' qui éta\gras{i}ent dans le monde,\\
Il les aima jusqu'à la fin.
