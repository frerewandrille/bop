\rubrique{Cantique p. \pageref{NTII}.}{2ex}{0pt}

\chapter{Mercredi Saint}
\label{ReponsMeS}
\par\begin{lilypond}
\include "FtAnt.ly" \include "Répons/Nous annonçons L420.ly" 
\end{lilypond}
\paragraph{1.}Je suis crucifi\gras{é} avec le Christ,\\
Et si je vis, ' ce n'est plus moi qui vis,\\
Mais c'est le Christ mort et ressuscité\\
qui v\gras{i}t en moi.
\pagebreak
\paragraph{Doxologie}Gloire au Père, ' qui n'a pas abandonné l'h\gras{o}mme à la mort.\\
Gloire au Fils, sagesse éternelle, ' et source du salut.\\
Gloire à l'Esprit d'amour\\
Qui fait de no\gras{u}s des vivants.
